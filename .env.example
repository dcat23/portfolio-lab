# GCP Configuration
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_REGISTRY=us-central1-docker.pkg.dev
GCP_REPOSITORY=portfolio

# PostgreSQL Database
# For local development, use localhost or docker service name
# For production, use your managed PostgreSQL instance (e.g., Neon, Cloud SQL)
DATABASE_USER=default
DATABASE_PASSWORD=password
DATABASE_HOST=localhost
DATABASE_NAME=postgres

# JWT Authentication
# Generate with: openssl rand -base64 64
JWT_SIGNING_KEY=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

GITHUB_OAUTH=